"""Actual App/RequestScheduler cancellation and completion integration."""
from moxi import App, Rect, TASK_COMPLETED
from runtime import HandlerHost, require
from lifetime_check import Root, target, count
from request_bridge import RequestBridge


def main():
    var app = App(HandlerHost(Root()), Rect(0, 0, 600, 900))
    var bridge = RequestBridge(app)
    var first = bridge.submit(app, target(app))
    bridge.change(app, Root.replace_values)
    require(bridge.complete(app, first), "assignment retains request lifetime")
    require(bridge.drain(app) == 1 and count(app) == 1, "completion reaches replacement values once")
    require(not bridge.complete(app, first) and bridge.drain(app) == 0, "duplicate completion rejected")
    var old = bridge.submit(app, target(app))
    require(bridge.complete(app, old), "queue old generation before superseding")
    var latest = bridge.submit(app, target(app))
    require(bridge.complete(app, latest), "complete latest generation")
    require(bridge.drain(app) == 1 and count(app) == 2, "ready superseded generation cannot mutate")
    var ready = bridge.submit(app, target(app))
    require(bridge.complete(app, ready), "complete before child reset")
    bridge.change(app, Root.reset_children)
    require(bridge.drain(app) == 0 and count(app) == 0, "already-ready child completion rejected")
    var pending = bridge.submit(app, target(app))
    bridge.change(app, Root.reset_children)
    require(not bridge.complete(app, pending) and bridge.drain(app) == 0, "pending child work cancelled")
    var background = app.schedule_request(99, "app-owned background", 60.0)
    var root_work = bridge.submit(app, target(app))
    bridge.reset(app, Root())
    require(len(bridge.pending) == 0, "root reset releases owned callbacks immediately")
    require(not bridge.complete(app, root_work), "root reset rejects old envelope")
    require(app.request_is_current(background), "root reset preserves unrelated App-owned request")
    require(bridge.drain(app) == 0 and count(app) == 0, "root cancellation cannot mutate new model")
    var fresh = bridge.submit(app, target(app))
    require(bridge.complete(app, fresh) and bridge.drain(app) == 1 and count(app) == 1, "fresh root completion works")
    var other = App(HandlerHost(Root()), Rect(0, 0, 600, 900))
    var other_bridge = RequestBridge(other)
    var source = App(HandlerHost(Root()), Rect(0, 0, 600, 900))
    var source_bridge = RequestBridge(source)
    var foreign = source_bridge.submit(source, target(source))
    var own = other_bridge.submit(other, target(other))
    require(foreign.request.task_id == own.request.task_id and foreign.request.scope_id == own.request.scope_id, "deliberate numeric request alias")
    require(not other_bridge.complete(other, foreign), "scope rejects foreign numeric request alias")
    require(other_bridge.complete(other, own) and other_bridge.drain(other) == 1 and count(other) == 1, "own request remains live")
    for _ in range(100):
        var churn = bridge.submit(app, target(app))
        bridge.reset(app, Root())
        require(not bridge.complete(app, churn) and bridge.drain(app) == 0, "churn rejects old requests")
        require(len(bridge.owners) == 0 and len(bridge.pending) == 0, "adapter records bounded after drain")
    require(len(app.requests.scopes) == 0, "closed scheduler scopes reclaimed")
    for key in range(100):
        var item = bridge.submit(app, target(app), key)
        require(bridge.complete(app, item), "produce ready overflow")
    require(bridge.drain(app) == app.requests.capacity(), "only retained ready completions deliver")
    require(len(bridge.pending) == 0, "overflow does not retain dropped callbacks")
    bridge.reset(app, Root())
    _ = bridge.drain(app)
    require(len(bridge.pending) == 0 and len(app.requests.scopes) == 0, "overflow reset reclaims callbacks and scopes")
    print("PASS App request integration: assignment, supersession, pending/ready reset, foreign hosts, unrelated work, churn")
