"""One effective command table for replay, toolbar and keyboard discovery.

Primary modifier mapping comes from moxi_canvas; reference exceptions documented
in tests/mindmap/freeplane-reference.json. Extensions have menu/palette access.
"""
from std.collections import List
from moxi.event import *
from moxi_canvas import CanvasBinding, CanvasCommand, ShortcutModifier, HostPlatform

@fieldwise_init
struct MapCommand(Equatable, ImplicitlyCopyable):
    var value: Int
    comptime NONE = Self(0)
    comptime CHILD = Self(1000)
    comptime SIBLING = Self(1001)
    comptime PREVIOUS = Self(1002)
    comptime PARENT = Self(1003)
    comptime EDIT = Self(1004)
    comptime MULTILINE = Self(1005)
    comptime UP = Self(1006)
    comptime DOWN = Self(1007)
    comptime LEFT = Self(1008)
    comptime RIGHT = Self(1009)
    comptime REORDER_UP = Self(1010)
    comptime REORDER_DOWN = Self(1011)
    comptime LEVEL_LEFT = Self(1012)
    comptime LEVEL_RIGHT = Self(1013)
    comptime FOLD = Self(1014)
    comptime NEXT_CHILD = Self(1015)
    comptime FOLD_CHILDREN = Self(1016)
    comptime FOLD_LEVEL = Self(1017)
    comptime UNFOLD_LEVEL = Self(1018)
    comptime FOLD_ALL = Self(1019)
    comptime UNFOLD_ALL = Self(1020)
    comptime SELECT_ALL = Self(1021)
    comptime SELECT_BRANCH = Self(1022)
    comptime ROOT = Self(1023)
    comptime FIND = Self(1024)
    comptime FIND_NEXT = Self(1025)
    comptime FILTER = Self(1026)
    comptime NODE_LIST = Self(1027)
    comptime CONNECT = Self(1028)
    comptime LINK = Self(1029)
    comptime UNDO = Self(1030)
    comptime REDO = Self(1031)
    comptime DELETE = Self(1032)
    comptime OUTLINE = Self(1033)
    comptime NOTES = Self(1034)
    comptime COPY = Self(1035)
    comptime CUT = Self(1036)
    comptime PASTE = Self(1037)
    comptime SAVE = Self(1038)
    comptime OPEN = Self(1039)
    comptime NEW = Self(1040)
    comptime MOVE = Self(1041)
    comptime SIDE = Self(1042)
    comptime SPACE_MORE = Self(1043)
    comptime SPACE_LESS = Self(1044)
    comptime DUPLICATE = Self(1045)
    comptime STYLE = Self(1046)
    comptime TAGS = Self(1047)
    comptime ICONS = Self(1048)
    comptime RECOVER = Self(1049)
    comptime IMPORT = Self(1050)
    comptime PALETTE = Self(1051)
    comptime EXIT_FOCUS = Self(1052)
    comptime ZOOM_IN = Self(1053)
    comptime ZOOM_OUT = Self(1054)
    comptime FIT = Self(1055)
    comptime ONE_SIDE = Self(1056)
    comptime SELECT_UP = Self(1057)
    comptime SELECT_DOWN = Self(1058)
    comptime LINK_LABEL = Self(1059)
    comptime UNLINK = Self(1060)
    comptime SELECT_LEFT = Self(1061)
    comptime SELECT_RIGHT = Self(1062)
    comptime PAGE_UP = Self(1063)
    comptime PAGE_DOWN = Self(1064)
    comptime SELECT_PAGE_UP = Self(1065)
    comptime SELECT_PAGE_DOWN = Self(1066)
    comptime EDIT_START = Self(1067)
    comptime EDIT_END = Self(1068)


def bindings(host: HostPlatform = HostPlatform.MACOS) -> List[CanvasBinding]:
    var b = List[CanvasBinding]()
    comptime M = ShortcutModifier
    b.append(CanvasBinding(KEY_TAB, M.NONE, CanvasCommand(MapCommand.CHILD.value), "Child · Tab"))
    b.append(CanvasBinding(KEY_ENTER, M.NONE, CanvasCommand(MapCommand.SIBLING.value), "Sibling · Enter"))
    b.append(CanvasBinding(KEY_ENTER, M.SHIFT, CanvasCommand(MapCommand.PREVIOUS.value), "Previous sibling · Shift+Enter"))
    b.append(CanvasBinding(KEY_TAB, M.SHIFT, CanvasCommand(MapCommand.PARENT.value), "Insert parent · Shift+Tab"))
    b.append(CanvasBinding(KEY_F2, M.NONE, CanvasCommand(MapCommand.EDIT.value), "Edit · F2"))
    b.append(CanvasBinding(KEY_F6, M.NONE, CanvasCommand(MapCommand.EXIT_FOCUS.value), "Toolbar focus · F6"))
    b.append(CanvasBinding(KEY_UP, M.NONE, CanvasCommand(MapCommand.UP.value), "Up"))
    b.append(CanvasBinding(KEY_DOWN, M.NONE, CanvasCommand(MapCommand.DOWN.value), "Down"))
    b.append(CanvasBinding(KEY_LEFT, M.NONE, CanvasCommand(MapCommand.LEFT.value), "Left"))
    b.append(CanvasBinding(KEY_RIGHT, M.NONE, CanvasCommand(MapCommand.RIGHT.value), "Right"))
    b.append(CanvasBinding(KEY_UP, M.SHIFT, CanvasCommand(MapCommand.SELECT_UP.value), "Extend selection up"))
    b.append(CanvasBinding(KEY_DOWN, M.SHIFT, CanvasCommand(MapCommand.SELECT_DOWN.value), "Extend selection down"))
    b.append(CanvasBinding(KEY_UP, M.PRIMARY, CanvasCommand(MapCommand.REORDER_UP.value), "Reorder up · Primary+Up"))
    b.append(CanvasBinding(KEY_DOWN, M.PRIMARY, CanvasCommand(MapCommand.REORDER_DOWN.value), "Reorder down · Primary+Down"))
    b.append(CanvasBinding(KEY_LEFT, M.PRIMARY, CanvasCommand(MapCommand.LEVEL_LEFT.value), "Level left · Primary+Left"))
    b.append(CanvasBinding(KEY_RIGHT, M.PRIMARY, CanvasCommand(MapCommand.LEVEL_RIGHT.value), "Level right · Primary+Right"))
    b.append(CanvasBinding(KEY_SPACE, M.NONE, CanvasCommand(MapCommand.FOLD.value), "Fold · Space"))
    b.append(CanvasBinding(KEY_SPACE, M.SHIFT, CanvasCommand(MapCommand.NEXT_CHILD.value), "Next child · Shift+Space"))
    b.append(CanvasBinding(KEY_ENTER, M.OPTION, CanvasCommand(MapCommand.MULTILINE.value), "Multiline editor · Alt+Enter"))
    b.append(CanvasBinding(KEY_PAGE_UP, M.OPTION, CanvasCommand(MapCommand.FOLD_LEVEL.value), "Fold one level · Alt+PageUp"))
    b.append(CanvasBinding(KEY_PAGE_DOWN, M.OPTION, CanvasCommand(MapCommand.UNFOLD_LEVEL.value), "Unfold one level · Alt+PageDown"))
    b.append(CanvasBinding(KEY_HOME, M.OPTION, CanvasCommand(MapCommand.FOLD_ALL.value), "Fold all · Alt+Home"))
    b.append(CanvasBinding(KEY_END, M.OPTION, CanvasCommand(MapCommand.UNFOLD_ALL.value), "Unfold all · Alt+End"))
    b.append(CanvasBinding(KEY_UP, M.OPTION, CanvasCommand(MapCommand.ZOOM_IN.value), "Zoom in · Alt+Up"))
    b.append(CanvasBinding(KEY_DOWN, M.OPTION, CanvasCommand(MapCommand.ZOOM_OUT.value), "Zoom out · Alt+Down"))
    b.append(CanvasBinding(-1, M.NONE, CanvasCommand(MapCommand.FOLD_CHILDREN.value), "Fold children (host conflict: Cmd+Space)"))
    # Primary+Space is host-reserved on macOS; keep an explicit palette alternative.
    if host != HostPlatform.MACOS:
        b.append(CanvasBinding(KEY_SPACE, M.PRIMARY, CanvasCommand(MapCommand.FOLD_CHILDREN.value), "Fold children · Primary+Space"))
    b.append(CanvasBinding(97, M.PRIMARY, CanvasCommand(MapCommand.SELECT_ALL.value), "Select all · Primary+A"))
    b.append(CanvasBinding(97, M.PRIMARY_SHIFT, CanvasCommand(MapCommand.SELECT_BRANCH.value), "Select branch · Primary+Shift+A"))
    b.append(CanvasBinding(KEY_ESCAPE, M.NONE, CanvasCommand(MapCommand.ROOT.value), "Root / cancel · Escape"))
    b.append(CanvasBinding(103, M.PRIMARY, CanvasCommand(MapCommand.FIND.value), "Find · Primary+G"))
    b.append(CanvasBinding(103, M.PRIMARY_SHIFT, CanvasCommand(MapCommand.FIND_NEXT.value), "Find next · Primary+Shift+G"))
    b.append(CanvasBinding(102, M.PRIMARY, CanvasCommand(MapCommand.FILTER.value), "Filter · Primary+F"))
    b.append(CanvasBinding(102, M.PRIMARY_SHIFT, CanvasCommand(MapCommand.NODE_LIST.value), "Node list · Primary+Shift+F"))
    b.append(CanvasBinding(108, M.PRIMARY, CanvasCommand(MapCommand.CONNECT.value), "Connector · Primary+L"))
    b.append(CanvasBinding(107, M.PRIMARY, CanvasCommand(MapCommand.LINK.value), "Hyperlink · Primary+K"))
    b.append(CanvasBinding(122, M.PRIMARY, CanvasCommand(MapCommand.UNDO.value), "Undo · Primary+Z"))
    b.append(CanvasBinding(122 if host == HostPlatform.MACOS else 121, M.PRIMARY_SHIFT if host == HostPlatform.MACOS else M.PRIMARY, CanvasCommand(MapCommand.REDO.value), "Redo"))
    b.append(CanvasBinding(KEY_BACKSPACE if host == HostPlatform.MACOS else KEY_DELETE, M.NONE, CanvasCommand(MapCommand.DELETE.value), "Delete"))
    b.append(CanvasBinding(111, M.PRIMARY_SHIFT, CanvasCommand(MapCommand.OUTLINE.value), "Outline · Primary+Shift+O"))
    b.append(CanvasBinding(46, M.PRIMARY, CanvasCommand(MapCommand.NOTES.value), "Notes · Primary+."))
    b.append(CanvasBinding(46, M.PRIMARY_SHIFT, CanvasCommand(MapCommand.NOTES.value), "Show notes · Primary+Shift+."))
    b.append(CanvasBinding(KEY_C, M.PRIMARY, CanvasCommand(MapCommand.COPY.value), "Copy branch · Primary+C"))
    b.append(CanvasBinding(KEY_X, M.PRIMARY, CanvasCommand(MapCommand.CUT.value), "Cut branch · Primary+X"))
    b.append(CanvasBinding(KEY_V, M.PRIMARY, CanvasCommand(MapCommand.PASTE.value), "Paste branch · Primary+V"))
    b.append(CanvasBinding(115, M.PRIMARY, CanvasCommand(MapCommand.SAVE.value), "Save · Primary+S"))
    b.append(CanvasBinding(111, M.PRIMARY, CanvasCommand(MapCommand.OPEN.value), "Open · Primary+O"))
    b.append(CanvasBinding(110, M.PRIMARY, CanvasCommand(MapCommand.NEW.value), "New · Primary+N"))
    b.append(CanvasBinding(KEY_LEFT, M.SHIFT, CanvasCommand(MapCommand.SELECT_LEFT.value), "Extend left"))
    b.append(CanvasBinding(KEY_RIGHT, M.SHIFT, CanvasCommand(MapCommand.SELECT_RIGHT.value), "Extend right"))
    b.append(CanvasBinding(KEY_PAGE_UP, M.NONE, CanvasCommand(MapCommand.PAGE_UP.value), "Page up"))
    b.append(CanvasBinding(KEY_PAGE_DOWN, M.NONE, CanvasCommand(MapCommand.PAGE_DOWN.value), "Page down"))
    b.append(CanvasBinding(KEY_PAGE_UP, M.SHIFT, CanvasCommand(MapCommand.SELECT_PAGE_UP.value), "Extend page up"))
    b.append(CanvasBinding(KEY_PAGE_DOWN, M.SHIFT, CanvasCommand(MapCommand.SELECT_PAGE_DOWN.value), "Extend page down"))
    b.append(CanvasBinding(KEY_HOME, M.NONE, CanvasCommand(MapCommand.EDIT_START.value), "Edit from start"))
    b.append(CanvasBinding(KEY_END, M.NONE, CanvasCommand(MapCommand.EDIT_END.value), "Edit from end"))
    # Extensions are palette/toolbar invocations, never stolen reference chords.
    var extra: List[String] = ["Move branch", "Change side", "More spacing", "Less spacing", "Duplicate (external links omitted)", "Cycle style", "Tags", "Icons", "Recover unsaved", "Import .mm", "Commands", "Leave map focus", "Zoom in", "Zoom out", "Fit map", "One-sided layout", "Extend up", "Extend down", "Crosslink label", "Remove crosslink"]
    for i in range(len(extra)):
        b.append(CanvasBinding(-1, M.NONE, CanvasCommand(MapCommand.MOVE.value + i), extra[i]))
    return b^
