from moxi_math import MathEditorState, MathCommand, MathKind, MathKeymap
from std.testing import assert_equal, assert_true

def main() raises:
    var editor = MathEditorState()
    editor.insert("x")
    editor.command(MathCommand.FRACTION)
    editor.insert("y")
    assert_equal(editor.document.text(), "frac(x, y)")
    editor.command(MathCommand.EXIT)
    editor.command(MathCommand.SUPER)
    editor.insert("2")
    assert_equal(editor.document.text(), "scripts(frac(x, y), ?, 2, ?, ?)")
    editor.command(MathCommand.SUB)
    editor.insert("i")
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    editor.command(MathCommand.UNDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), ?, 2, ?, ?)")
    editor.command(MathCommand.REDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    editor.command(MathCommand.TEXT)
    _ = editor.source.select_all()
    editor.insert("frac(x,")
    assert_true(editor.document.nodes[editor.document.root].kind == MathKind.ERROR)
    assert_equal(editor.document.nodes[editor.document.root].text, "frac(x,")
    editor.command(MathCommand.TEXT)
    editor.command(MathCommand.UNDO)
    assert_true(editor.text_mode)
    editor.command(MathCommand.UNDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    var matrix = MathEditorState("row(a, b)")
    matrix.select(matrix.document.root)
    matrix.command(MathCommand.MATRIX)
    matrix.command(MathCommand.ADD_ROW)
    matrix.insert("c")
    matrix.command(MathCommand.NEXT_HOLE)
    matrix.insert("d")
    assert_equal(matrix.document.text(), "matrix(row(a, b), row(c, d))")
    matrix.command(MathCommand.ADD_COLUMN)
    assert_equal(matrix.document.text(), "matrix(row(a, b, ?), row(c, d, ?))")
    matrix.command(MathCommand.REMOVE_COLUMN)
    assert_equal(matrix.document.text(), "matrix(row(a, b), row(c, d))")
    var saved = matrix.save_text()
    var reopened = MathEditorState()
    reopened.load_text(saved)
    assert_equal(reopened.document.text(), matrix.document.text())
    var unicode = MathEditorState()
    unicode.insert("é")
    unicode.delete()
    assert_equal(unicode.document.text(), "?")
    unicode.escape()
    unicode.insert("a")
    unicode.escape()
    assert_equal(unicode.document.text(), "α")
    # Clipboard fragments allocate fresh IDs, preserve source notation, and undo.
    var copy=matrix.copy_text()
    var old_id=matrix.document.nodes[matrix.target()].id
    matrix.paste(copy)
    assert_true(matrix.document.nodes[matrix.target()].id!=old_id)
    matrix.document.validate()
    var revision=matrix.document.revision
    matrix.load_text(saved)
    assert_true(matrix.document.revision>revision)
    var target=matrix.document.nodes[matrix.document.root].id
    assert_true(not matrix.apply_fragment('frac(error("bad"), x)',target,matrix.document.revision))
    assert_true(not matrix.apply_fragment("x",target,matrix.document.revision-1))
    # A move into an empty slot is one undoable transaction.
    var move=MathEditorState("frac(x, ?)")
    var x=move.document.nodes[move.document.root].children[0]
    var hole=move.document.nodes[move.document.root].children[1]
    move.select(x)
    move.begin_drag()
    move.drag_target=move.document.nodes[hole].id
    assert_true(move.drop())
    assert_equal(move.document.text(),"frac(?, x)")
    move.command(MathCommand.UNDO)
    assert_equal(move.document.text(),"frac(x, ?)")
    move.select(move.document.root)
    move.begin_drag()
    move.drag_target=move.document.nodes[move.document.nodes[move.document.root].children[1]].id
    assert_true(not move.drop())
    move.begin_drag(); move.escape()
    assert_equal(move.drag_id,-1)
    # Text selections map back to the visual slot; unrelated IDs survive edits.
    var linked=MathEditorState("frac(alpha, beta)")
    var child=linked.document.nodes[linked.document.root].children[1]
    var child_id=linked.document.nodes[child].id
    linked.select(child)
    linked.command(MathCommand.TEXT)
    assert_equal(linked.source.selected_text(),"beta")
    linked.insert("gamma")
    linked.command(MathCommand.TEXT)
    assert_equal(linked.selected,child_id)
    assert_equal(linked.document.nodes[linked.target()].text,"gamma")
    var keymap=MathKeymap()
    keymap.bind(MathCommand.FRACTION,102,2,"⌘F")
    assert_true(keymap.resolve(102,2)==MathCommand.FRACTION)
    assert_equal(keymap.resolve(47,2).value,0)
    var pair=MathEditorState("scripts(x, i, 2, n, k)")
    pair.focus(pair.document.nodes[pair.document.root].children[3])
    pair.command(MathCommand.COMPLEMENT)
    assert_equal(pair.document.nodes[pair.index()].text,"k")
    pair.command(MathCommand.COMPLEMENT)
    assert_equal(pair.document.nodes[pair.index()].text,"n")
    linked.command(MathCommand.TEXT)
    var committed_source=linked.source.text
    var committed_document=linked.document.text()
    linked.begin()
    linked.source.set_text("a\x00b")
    var rejected=False
    try:
        linked.parse_source()
    except:
        rejected=True
    assert_true(rejected)
    assert_equal(linked.source.text,committed_source)
    assert_equal(linked.document.text(),committed_document)
    print("PASS clipboard IDs, stale/reopen revisions, result validation, drag move/cancel, source spans, key remapping, complementary pairs")
    print("PASS structural replay, history, text/error, matrix, persistence, grapheme, symbol")
