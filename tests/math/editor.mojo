from moxi_math import MathEditorState, MathPosition, MathCommand, MathKind, MathKeymap
from std.testing import assert_equal, assert_true

def main() raises:
    var editor = MathEditorState()
    editor.insert("x")
    editor.command(MathCommand.FRACTION)
    editor.insert("y")
    assert_equal(editor.document.text(), "frac(x, y)")
    editor.command(MathCommand.EXIT)
    editor.command(MathCommand.SUPER)
    editor.insert("2")
    assert_equal(editor.document.text(), "scripts(frac(x, y), ?, 2, ?, ?)")
    editor.command(MathCommand.SUB)
    editor.insert("i")
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    editor.command(MathCommand.UNDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), ?, 2, ?, ?)")
    editor.command(MathCommand.REDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    editor.command(MathCommand.TEXT)
    _ = editor.source.select_all()
    editor.insert("frac(x,")
    assert_true(editor.document.nodes[editor.document.root].kind == MathKind.ERROR)
    assert_equal(editor.document.nodes[editor.document.root].text, "frac(x,")
    editor.command(MathCommand.TEXT)
    editor.command(MathCommand.UNDO)
    assert_true(editor.text_mode)
    editor.command(MathCommand.UNDO)
    assert_equal(editor.document.text(), "scripts(frac(x, y), i, 2, ?, ?)")
    var matrix = MathEditorState("row(a, b)")
    matrix.select(matrix.document.root)
    matrix.command(MathCommand.MATRIX)
    matrix.command(MathCommand.ADD_ROW)
    matrix.insert("c")
    matrix.command(MathCommand.NEXT_HOLE)
    matrix.insert("d")
    assert_equal(matrix.document.text(), "matrix(row(a, b), row(c, d))")
    matrix.command(MathCommand.ADD_COLUMN)
    assert_equal(matrix.document.text(), "matrix(row(a, b, ?), row(c, d, ?))")
    matrix.command(MathCommand.REMOVE_COLUMN)
    assert_equal(matrix.document.text(), "matrix(row(a, b), row(c, d))")
    var saved = matrix.save_text()
    var reopened = MathEditorState()
    reopened.load_text(saved)
    assert_equal(reopened.document.text(), matrix.document.text())
    var unicode = MathEditorState()
    unicode.insert("é")
    unicode.delete()
    assert_equal(unicode.document.text(), "?")
    unicode.escape()
    unicode.insert("a")
    unicode.escape()
    assert_equal(unicode.document.text(), "α")
    # Clipboard fragments allocate fresh IDs, preserve source notation, and undo.
    matrix.select(matrix.target())
    var copy=matrix.copy_text()
    var old_id=matrix.document.nodes[matrix.target()].id
    matrix.paste(copy)
    assert_true(matrix.document.nodes[matrix.target()].id!=old_id)
    matrix.document.validate()
    var revision=matrix.document.revision
    matrix.load_text(saved)
    assert_true(matrix.document.revision>revision)
    var target=matrix.document.nodes[matrix.document.root].id
    assert_true(not matrix.apply_fragment('frac(error("bad"), x)',target,matrix.document.revision))
    assert_true(not matrix.apply_fragment("x",target,matrix.document.revision-1))
    # A move into an empty slot is one undoable transaction.
    var move=MathEditorState("frac(x, ?)")
    var x=move.document.nodes[move.document.root].children[0]
    var hole=move.document.nodes[move.document.root].children[1]
    move.select(x)
    move.begin_drag()
    move.drag_target=move.document.nodes[hole].id
    assert_true(move.drop())
    assert_equal(move.document.text(),"frac(?, x)")
    move.command(MathCommand.UNDO)
    assert_equal(move.document.text(),"frac(x, ?)")
    move.select(move.document.root)
    move.begin_drag()
    move.drag_target=move.document.nodes[move.document.nodes[move.document.root].children[1]].id
    assert_true(not move.drop())
    move.begin_drag(); move.escape()
    assert_equal(move.drag_id,-1)
    # Text selections map back to the visual slot; unrelated IDs survive edits.
    var linked=MathEditorState("frac(alpha, beta)")
    var child=linked.document.nodes[linked.document.root].children[1]
    var child_id=linked.document.nodes[child].id
    linked.select(child)
    linked.command(MathCommand.TEXT)
    assert_equal(linked.source.selected_text(),"beta")
    linked.insert("gamma")
    linked.command(MathCommand.TEXT)
    assert_true(linked.selected<0)
    assert_equal(linked.caret.id,child_id)
    assert_equal(linked.caret.offset,5)
    assert_equal(linked.document.nodes[linked.target()].text,"gamma")
    var keymap=MathKeymap()
    keymap.bind(MathCommand.FRACTION,102,2,"⌘F")
    assert_true(keymap.resolve(102,2)==MathCommand.FRACTION)
    assert_equal(keymap.resolve(47,2).value,0)
    var pair=MathEditorState("scripts(x, i, 2, n, k)")
    pair.focus(pair.document.nodes[pair.document.root].children[3])
    pair.command(MathCommand.COMPLEMENT)
    assert_equal(pair.document.nodes[pair.index()].text,"k")
    pair.command(MathCommand.COMPLEMENT)
    assert_equal(pair.document.nodes[pair.index()].text,"n")
    linked.command(MathCommand.TEXT)
    var committed_source=linked.source.text
    var committed_document=linked.document.text()
    linked.begin()
    linked.source.set_text("a\x00b")
    var rejected=False
    try:
        linked.parse_source()
    except:
        rejected=True
    assert_true(rejected)
    assert_equal(linked.source.text,committed_source)
    assert_equal(linked.document.text(),committed_document)
    # Arrow keys stop at document edges, and Shift extends and contracts by grapheme.
    var navigation=MathEditorState("abc")
    navigation.horizontal(-1)
    assert_equal(navigation.caret.offset,0)
    navigation.focus(navigation.document.root,True)
    navigation.horizontal(1)
    assert_equal(navigation.caret.offset,3)
    navigation.horizontal(-1,True)
    assert_equal(navigation.copy_text(),"c")
    assert_true(navigation.selected<0)
    navigation.horizontal(-1,True)
    assert_equal(navigation.copy_text(),"bc")
    navigation.horizontal(1,True)
    assert_equal(navigation.copy_text(),"c")
    navigation.horizontal(1,True)
    assert_true(not navigation.has_text_selection())
    assert_equal(navigation.caret.offset,3)
    navigation.horizontal(-1,True)
    navigation.horizontal(-1)
    assert_equal(navigation.caret.offset,2)
    assert_true(not navigation.has_text_selection())
    navigation.horizontal(1,True)
    navigation.horizontal(1)
    assert_equal(navigation.caret.offset,3)
    # Typing and either delete key replace exactly the selected token substring.
    var replacement=MathEditorState("abcdef")
    var token_id=replacement.caret.id
    replacement.set_caret(MathPosition(token_id,2))
    replacement.set_caret(MathPosition(token_id,4),True)
    assert_equal(replacement.copy_text(),"cd")
    replacement.insert("X")
    assert_equal(replacement.document.text(),"abXef")
    assert_equal(replacement.caret.offset,3)
    assert_true(not replacement.has_text_selection())
    replacement.command(MathCommand.UNDO)
    assert_equal(replacement.copy_text(),"cd")
    replacement.delete(True)
    assert_equal(replacement.document.text(),"abef")
    assert_equal(replacement.caret.offset,2)
    replacement.command(MathCommand.UNDO)
    replacement.delete()
    assert_equal(replacement.document.text(),"abef")
    replacement.command(MathCommand.UNDO)
    replacement.command(MathCommand.REDO)
    assert_equal(replacement.document.text(),"abef")
    assert_true(not replacement.has_text_selection())
    # Dragging across slots selects their common structure; returning contracts.
    var range=MathEditorState("frac(alpha, beta)")
    var numerator=range.document.nodes[range.document.root].children[0]
    var denominator=range.document.nodes[range.document.root].children[1]
    var numerator_id=range.document.nodes[numerator].id
    var denominator_id=range.document.nodes[denominator].id
    range.set_caret(MathPosition(denominator_id,2),True)
    assert_equal(range.selected,range.document.nodes[range.document.root].id)
    range.set_caret(MathPosition(numerator_id,2),True)
    assert_true(range.selected<0)
    assert_equal(range.copy_text(),"al")
    range.set_caret(MathPosition(numerator_id,0),True)
    assert_true(not range.has_text_selection())
    # Shift selection preserves combining sequences and supplementary characters.
    var cluster=MathEditorState()
    cluster.insert("é🙂")
    cluster.horizontal(-1,True)
    assert_equal(cluster.copy_text(),"🙂")
    cluster.horizontal(-1,True)
    assert_equal(cluster.copy_text(),"é🙂")
    assert_equal(cluster.caret.offset,0)
    cluster.delete()
    assert_equal(cluster.document.text(),"?")
    cluster.command(MathCommand.UNDO)
    assert_equal(cluster.copy_text(),"é🙂")
    cluster.insert("q")
    assert_equal(cluster.document.text(),"q")
    # Plain pasted tokens insert at the caret or replace a selected substring.
    var pasted=MathEditorState("abcd")
    var pasted_id=pasted.caret.id
    pasted.set_caret(MathPosition(pasted_id,2))
    pasted.paste("XY")
    assert_equal(pasted.document.text(),"abXYcd")
    assert_equal(pasted.caret.id,pasted_id)
    pasted.set_caret(MathPosition(pasted_id,4),True)
    pasted.set_caret(MathPosition(pasted_id,2),True)
    pasted.paste("Z")
    assert_equal(pasted.document.text(),"abZcd")
    pasted.command(MathCommand.UNDO)
    assert_equal(pasted.copy_text(),"XY")
    var literal=MathEditorState()
    literal.insert("pre ? (x) post")
    literal.set_caret(MathPosition(literal.caret.id,4))
    literal.set_caret(MathPosition(literal.caret.id,9),True)
    assert_equal(literal.copy_text(),"? (x)")
    pasted.paste(literal.copy_fragment_text())
    assert_equal(pasted.document.nodes[pasted.index()].text,"ab? (x)cd")
    pasted.command(MathCommand.UNDO)
    assert_equal(pasted.copy_text(),"XY")
    var first=range.edge_position()
    var last=range.edge_position(True)
    assert_equal(first.id,numerator_id)
    assert_equal(first.offset,0)
    assert_equal(last.id,denominator_id)
    assert_equal(last.offset,4)
    var slots=MathEditorState("row(ab, cd)")
    var first_slot=slots.document.nodes[slots.document.root].children[0]
    var last_slot=slots.document.nodes[slots.document.root].children[1]
    slots.focus(first_slot,True)
    slots.horizontal(1,True)
    assert_equal(slots.selected,slots.document.nodes[slots.document.root].id)
    slots.horizontal(-1,True)
    assert_true(not slots.has_text_selection())
    assert_true(slots.selected<0)
    assert_equal(slots.caret.id,slots.document.nodes[first_slot].id)
    assert_equal(slots.caret.offset,2)
    slots.horizontal(1)
    assert_equal(slots.caret.id,slots.document.nodes[last_slot].id)
    assert_equal(slots.caret.offset,0)
    slots.horizontal(-1)
    assert_equal(slots.caret.id,slots.document.nodes[first_slot].id)
    assert_equal(slots.caret.offset,2)
    # Text/2D toggles preserve token carets and the direction of partial ranges.
    var modes=MathEditorState("frac(alpha, beta)")
    var mode_id=modes.caret.id
    modes.set_caret(MathPosition(mode_id,2))
    modes.command(MathCommand.TEXT)
    assert_equal(modes.source.cursor,7)
    assert_true(not modes.source.has_selection())
    modes.command(MathCommand.TEXT)
    assert_equal(modes.caret.id,mode_id)
    assert_equal(modes.caret.offset,2)
    assert_true(modes.selected<0)
    modes.insert("X")
    assert_equal(modes.document.text(),"frac(alXpha, beta)")
    modes.set_caret(MathPosition(mode_id,5))
    modes.set_caret(MathPosition(mode_id,2),True)
    modes.command(MathCommand.TEXT)
    assert_equal(modes.source.anchor,10)
    assert_equal(modes.source.cursor,7)
    assert_equal(modes.source.selected_text(),"Xph")
    modes.command(MathCommand.TEXT)
    assert_equal(modes.selection_anchor.offset,5)
    assert_equal(modes.caret.offset,2)
    assert_equal(modes.copy_text(),"Xph")
    modes.insert("Y")
    assert_equal(modes.document.text(),"frac(alYa, beta)")
    # Quoted spellings map encoded escapes to decoded token offsets.
    var escaped=MathEditorState()
    escaped.insert("a\n\"\\é🙂z")
    var escaped_id=escaped.caret.id
    escaped.set_caret(MathPosition(escaped_id,6))
    escaped.set_caret(MathPosition(escaped_id,2),True)
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.source.anchor,10)
    assert_equal(escaped.source.cursor,4)
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.selection_anchor.offset,6)
    assert_equal(escaped.caret.offset,2)
    assert_equal(escaped.copy_text(),"\"\\é")
    escaped.set_caret(MathPosition(escaped_id,6))
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.source.cursor,10)
    assert_true(not escaped.source.has_selection())
    escaped.source.cursor=9
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.caret.offset,4)
    assert_true(escaped.selected<0)
    escaped.command(MathCommand.TEXT)
    escaped.source.cursor=3
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.caret.offset,1)
    escaped.select(escaped.document.root)
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.source.anchor,0)
    assert_equal(escaped.source.cursor,escaped.source.text.count_codepoints())
    escaped.command(MathCommand.TEXT)
    assert_equal(escaped.selected,escaped_id)
    var full_range=MathEditorState("word")
    full_range.set_caret(MathPosition(full_range.caret.id,4),True)
    full_range.command(MathCommand.TEXT)
    full_range.command(MathCommand.TEXT)
    assert_true(full_range.has_text_selection())
    assert_equal(full_range.copy_text(),"word")
    # A source range across nodes selects their subtree; a collapsed gap stays a caret.
    var source_span=MathEditorState("row(alpha, beta)")
    source_span.command(MathCommand.TEXT)
    source_span.source.anchor=6
    source_span.source.cursor=13
    source_span.command(MathCommand.TEXT)
    assert_equal(source_span.selected,source_span.document.nodes[source_span.document.root].id)
    source_span.command(MathCommand.TEXT)
    source_span.source.anchor = -1
    source_span.source.cursor=10
    source_span.command(MathCommand.TEXT)
    assert_true(source_span.selected<0)
    assert_true(not source_span.has_text_selection())
    assert_equal(source_span.caret.offset,5)
    print("PASS caret edges, token ranges, range replacement/delete/history, structural contraction, Unicode selection")
    print("PASS plain paste at caret/range, literal substring clipboard, document endpoints")
    print("PASS Text/2D caret/range mapping, escaped source offsets, grapheme snapping, structural source spans")
    print("PASS clipboard IDs, stale/reopen revisions, result validation, drag move/cancel, source spans, key remapping, complementary pairs")
    print("PASS structural replay, history, text/error, matrix, persistence, grapheme, symbol")
