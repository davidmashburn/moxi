"""Wave C contract/Scene/event replay harness; fixture driver is generated by verify.py."""
from std.time import perf_counter
from moxi import Rect, Color, Event, CLICK_KIND, CanvasSceneRenderer, SvgSceneRenderer, SoftwareSceneRenderer, test_check
from moxi_plot.plot_spec import plot_spec_from_json, plot_from_spec
from moxi_plot.plot_point import PlotGlyphKind
from moxi_plot.plot_data import PlotDataTable
from moxi_plot.plot_view import PlotView


def check_case(name: String, document: String, data: PlotDataTable, changed: PlotDataTable, invalid: PlotDataTable, output: String) raises:
    var spec=plot_spec_from_json(document)
    test_check(spec.validate())
    test_check(spec.validate_data(data))
    print("spec|",name,"|",spec.to_json())
    var plot=plot_from_spec(spec,data,Rect(0,0,640,480))
    test_check(plot.series[0].has_layout_domain)
    test_check(plot.build_render_packet().fallback_required)
    var selected_index = -1
    var selected_x: Float32=0
    var selected_y: Float32=0
    for i in range(len(plot.series[0].points)):
        var p=plot.series[0].points[i]
        print("glyph|",name,"|",p.glyph.value,"|",p.row_key,"|",p.part,"|",p.x,"|",p.y,"|",p.x2,"|",p.y2,"|",p.x3,"|",p.y3,"|",p.source_keys_text(),"|",p.interactive,"|",p.size,"|",p.stroke_width)
        if not p.interactive: continue
        var center=p
        center.x=(p.x+p.x2)*0.5
        center.y=(p.y+p.y2)*0.5
        if p.glyph.value == PlotGlyphKind.TRIANGLE.value:
            center.x=(p.x+p.x2+p.x3)/3
            center.y=(p.y+p.y2+p.y3)/3
        var screen=plot.screen_point(center)
        var hit=plot.hit_test(screen,0.1)
        if hit.found() and hit.row_key==p.row_key and selected_index<0:
            selected_index=i
            selected_x=screen.x
            selected_y=screen.y
    test_check(selected_index>=0)
    var view=PlotView(spec,data,Rect(0,0,640,480))
    var click=Event()
    click.kind=CLICK_KIND
    click.position.x=selected_x
    click.position.y=selected_y
    test_check(view.dispatch(click))
    test_check(view.selected_count()==1)
    print("selection|",name,"|",plot.series[0].points[selected_index].row_key,"|",selected_x,"|",selected_y,"|",plot.series[0].points[selected_index].source_keys_text())
    print("phase|",name,"|semantics")
    test_check(view.accessibility().count()>=data.row_count()+2)
    test_check(not view.runtime.plot.set_point(1,0,99,99))
    var original=CanvasSceneRenderer(640,480,Color(1,1,1,1))
    original.render_scene(plot.build_scene())
    test_check(original.error_count()==0)
    original.write_png(output+"/"+name+"-canvas.png")
    var svg=SvgSceneRenderer(640,480)
    svg.render_scene(plot.build_scene())
    with open(output+"/"+name+"-scene.svg","w") as f: f.write(svg.markup())
    var software=SoftwareSceneRenderer(640,480,Color(1,1,1,1))
    software.render_scene(plot.build_scene())
    with open(output+"/"+name+"-software.ppm","w") as f: f.write(software.ppm())
    var selected=CanvasSceneRenderer(640,480,Color(1,1,1,1))
    selected.render_scene(view.build_scene())
    selected.write_png(output+"/"+name+"-selected.png")
    with open(output+"/"+name+"-table.csv","w") as f: f.write(view.data_table_csv())
    print("phase|",name,"|update")
    test_check(spec.validate_data(changed))
    test_check(view.replace_data(changed))
    test_check(view.selected_count()==0)
    var updated=CanvasSceneRenderer(640,480,Color(1,1,1,1))
    updated.render_scene(view.build_scene())
    updated.write_png(output+"/"+name+"-updated.png")
    print("phase|",name,"|recovery")
    test_check(not spec.validate_data(invalid))
    test_check(not view.replace_data(invalid))
    test_check(not view.request_data(invalid))
    test_check(view.replace_data(data))
    var restored=CanvasSceneRenderer(640,480,Color(1,1,1,1))
    restored.render_scene(view.build_scene())
    restored.write_png(output+"/"+name+"-restored.png")
    for sample in range(7):
        var start=perf_counter()
        var checksum=0
        for _ in range(10):
            var next=plot_from_spec(spec,data,Rect(0,0,640,480))
            checksum+=next.build_scene().count()
        print("benchmark|",name,"|",sample,"|",perf_counter()-start,"|",checksum)


def check_rejection(document: String, data: PlotDataTable):
    var spec=plot_spec_from_json(document)
    test_check(not spec.validate() or not spec.validate_data(data))


def check_positive(document: String, data: PlotDataTable, expected_count: Int):
    var spec=plot_spec_from_json(document)
    test_check(spec.validate_data(data))
    var plot=plot_from_spec(spec,data,Rect(0,0,640,480))
    test_check(plot.series[0].count()==expected_count)
    test_check(plot.series[0].line_width==spec.layers[0].line_width)
    test_check(plot.series[0].marker_size==spec.layers[0].size)
    test_check(plot.series[0].opacity==spec.layers[0].opacity)
    var again=plot_from_spec(spec,data,Rect(0,0,640,480))
    for i in range(expected_count):
        test_check(plot.series[0].points[i].x==again.series[0].points[i].x)
        test_check(plot.series[0].points[i].source_keys==again.series[0].points[i].source_keys)


def main(): pass
