<?xml version="1.0" encoding="UTF-8"?>
<openbox_config xmlns="http://openbox.org/3.4/rc">
  <focus>
    <focusNew>yes</focusNew>
    <followMouse>no</followMouse>
  </focus>
  <keyboard>
    <keybind key="A-F4"><action name="Close"/></keybind>
  </keyboard>
  <!-- Isolated automation activates its own client. Client mouse bindings use
       synchronous pointer grabs, which can delay clicks behind queued keys. -->
  <mouse/>
</openbox_config>
