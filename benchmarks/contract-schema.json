{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmashburn/moxi/benchmarks/contract-schema.json",
  "title": "Moxi host-independent deterministic benchmark contract",
  "type": "object",
  "required": ["schema_version", "profile", "source_report_schema_version", "cases"],
  "properties": {
    "schema_version": {"const": 1},
    "profile": {"enum": ["quick", "full"]},
    "source_report_schema_version": {"const": 2},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "signature"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "signature": {
            "type": "object",
            "required": ["metric_lines", "checksums"],
            "properties": {
              "metric_lines": {"type": "array", "items": {"type": "string"}},
              "checksums": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
