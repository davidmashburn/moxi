{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/davidmashburn/moxi/benchmarks/result-schema.json",
  "title": "Moxi structured benchmark result",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "requested_runs",
    "warmup_runs",
    "environment",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "profile": {
      "enum": ["quick", "full"]
    },
    "requested_runs": {
      "type": "integer",
      "minimum": 1
    },
    "warmup_runs": {
      "type": "integer",
      "minimum": 0
    },
    "environment": {
      "type": "object",
      "required": [
        "git_revision",
        "git_dirty",
        "mojo_version",
        "os",
        "architecture"
      ],
      "properties": {
        "git_revision": {"type": "string", "minLength": 1},
        "git_dirty": {"type": "boolean"},
        "mojo_version": {"type": "string", "minLength": 1},
        "os": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "command", "parameters", "runs"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "command": {"type": "string", "minLength": 1},
          "parameters": {
            "type": "object",
            "required": ["profile", "requested_runs", "warmup_runs"],
            "properties": {
              "profile": {"enum": ["quick", "full"]},
              "requested_runs": {"type": "integer", "minimum": 1},
              "warmup_runs": {"type": "integer", "minimum": 0}
            },
            "additionalProperties": false
          },
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "run",
                "status",
                "wall_seconds",
                "metric_lines"
              ],
              "properties": {
                "run": {"type": "integer", "minimum": 1},
                "status": {"type": "integer", "minimum": 0},
                "wall_seconds": {"type": "number", "minimum": 0},
                "metric_lines": {
                  "type": "array",
                  "items": {"type": "string"}
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
